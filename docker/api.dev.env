RUST_LOG=info,sea_orm=trace,sqlx=warn,tower_http=trace
CORS_ALLOWED_ORIGINS=http://localhost:${BIKE_RUST_UI_PORT:-3001}
LOCAL_ADMIN_ENABLED=${LOCAL_ADMIN_ENABLED:-true}
OAUTH_PROVIDERS=dev
OAUTH_DEV_ENABLED=true
OAUTH_DEV_EMAIL=developer@bike.local
OAUTH_DEV_NAME=Local Developer
