# Defaults shared by the API and worker; Compose overlays own environment differences.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/bike
UPLOADS_DIR=/app/uploads
JWT_SECRET=${BIKE_JWT_SECRET:-change_me_in_dev}
STRAVA_TOKEN_ENCRYPTION_KEY=${STRAVA_TOKEN_ENCRYPTION_KEY:-}
RUST_LOG=info,sqlx=warn
TEMPORAL_ADDRESS=${BIKE_TEMPORAL_ADDRESS:-http://temporal:7233}
TEMPORAL_NAMESPACE=bike
STRAVA_CLIENT_ID=${STRAVA_CLIENT_ID:-}
STRAVA_CLIENT_SECRET=${STRAVA_CLIENT_SECRET:-}
