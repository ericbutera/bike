CARGO_HOME=/cache/cargo
CARGO_TARGET_DIR=/cache/target/dev
CARGO_INCREMENTAL=0
CARGO_PROFILE_DEV_DEBUG=1
CARGO_PROFILE_TEST_DEBUG=1
RUSTFLAGS=-D warnings
RUSTDOCFLAGS=-D warnings
XDG_CACHE_HOME=/cache/xdg
NPM_CONFIG_CACHE=/cache/node-packages/npm
NPM_CONFIG_UPDATE_NOTIFIER=false
PNPM_CONFIG_UPDATE_NOTIFIER=false
PNPM_CONFIG_STORE_DIR=/cache/node-packages/pnpm-store
PNPM_CONFIG_CACHE_DIR=/cache/node-packages/pnpm-metadata
GOCACHE=/cache/go/go-build
GOMODCACHE=/cache/go/go-mod
TMPDIR=/tmp
