# API-only defaults; the worker does not inherit these settings.
OTEL_TRACES_EXPORTER=${OTEL_TRACES_EXPORTER:-none}
OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-}
FRONTEND_URL=${BIKE_FRONTEND_URL:-http://localhost:3001}
API_URL=${BIKE_BACKEND_URL:-http://localhost:3000}
STRAVA_WEBHOOK_VERIFY_TOKEN=${STRAVA_WEBHOOK_VERIFY_TOKEN:-}
STRAVA_SUBSCRIPTION_ID=${STRAVA_SUBSCRIPTION_ID:-}
STRAVA_OAUTH_SCOPES=activity:read_all
APP_NAME=Bike
MAP_RENDERER_GRPC_ADDRESS=http://bike-maps:50051
MAP_SERVICE_TOKEN=${MAP_SERVICE_TOKEN:-}
MAP_IMAGE_CACHE_DIR=/cache
MAP_IMAGE_CACHE_TTL_SECONDS=${MAP_IMAGE_CACHE_TTL_SECONDS:-604800}
