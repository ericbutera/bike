# Development cache settings come from dev-cache.env; only differences live here.
MISE_DATA_DIR=/cache/mise
MISE_CACHE_DIR=/cache/mise-cache
MISE_STATE_DIR=/cache/mise-state
MISE_YES=1
MISE_TASK_RUN_AUTO_INSTALL=true
BIKE_CHECKS_CONTAINER=1
CARGO_TARGET_DIR=/cache/target/checks
CARGO_LLVM_COV_TARGET_DIR=/cache/target/checks/llvm-cov-target
RUSTUP_HOME=/cache/rustup
UV_CACHE_DIR=/cache/uv
PREK_HOME=/cache/prek
BIKE_NODE_PACKAGE_CACHE=/cache/node-packages
BIKE_GO_CACHE=/cache/go
BUILDX_CONFIG=/cache/docker-buildx
BUILDX_BUILDER=bike-local
GH_PROMPT_DISABLED=1
GIT_TERMINAL_PROMPT=0
GIT_CONFIG_COUNT=3
GIT_CONFIG_KEY_0=safe.directory
GIT_CONFIG_KEY_1=credential.helper
GIT_CONFIG_VALUE_1=
GIT_CONFIG_KEY_2=credential.https://github.com.helper
GIT_CONFIG_VALUE_2='!gh auth git-credential'
