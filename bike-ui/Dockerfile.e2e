ARG NODE_VERSION=24.21.0
FROM node:${NODE_VERSION}-bookworm
ARG NPM_VERSION=12.2.0
ARG PNPM_VERSION=12.9.1
WORKDIR /workspace/bike-ui
RUN npm install --global npm@${NPM_VERSION} pnpm@${PNPM_VERSION}
COPY bike-ui/package.json bike-ui/pnpm-lock.yaml bike-ui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
RUN pnpm exec playwright install --with-deps chromium
COPY bike-ui/playwright.config.mjs ./
COPY bike-ui/tests/e2e ./tests/e2e
COPY bike-rs/docs/openapi/openapi.json /workspace/bike-rs/docs/openapi/openapi.json
COPY bike-rs/api/tests/fixtures/platform/uploads /workspace/bike-rs/api/tests/fixtures/platform/uploads
ENTRYPOINT ["pnpm", "exec", "playwright", "test"]
CMD ["tests/e2e/platform-synthetic.spec.mjs"]
