ARG NODE_IMAGE
ARG PLAYWRIGHT_IMAGE
ARG DOCKER_CLI_IMAGE
FROM ${DOCKER_CLI_IMAGE:-scratch} AS docker
FROM ${NODE_IMAGE:-scratch} AS node
FROM ${PLAYWRIGHT_IMAGE:-scratch}
COPY --from=node /usr/local/ /usr/local/
COPY --from=docker /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/
ARG NPM_VERSION
ARG PNPM_VERSION
WORKDIR /workspace/bike-ui
RUN npm install --global "npm@${NPM_VERSION:?NPM_VERSION must be supplied by mise}"
RUN npm install --global --allow-scripts=pnpm "pnpm@${PNPM_VERSION:?PNPM_VERSION must be supplied by mise}"
COPY bike-ui/package.json bike-ui/pnpm-lock.yaml bike-ui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY bike-ui/playwright.config.mjs ./
COPY bike-ui/tests/e2e ./tests/e2e
COPY bike-ui/public/map-styles ./public/map-styles
COPY contracts/openapi/openapi.json /workspace/contracts/openapi/openapi.json
COPY bike-rs/api/tests/fixtures/platform /workspace/bike-rs/api/tests/fixtures/platform
COPY compose.runtime.yaml compose.e2e.yaml /workspace/
COPY scripts/e2e-state.sh /workspace/scripts/e2e-state.sh
COPY scripts/e2e-reset.sql /workspace/scripts/e2e-reset.sql
RUN mkdir -p .artifacts/playwright
ENTRYPOINT ["xvfb-run", "--auto-servernum", "pnpm", "exec", "playwright", "test"]
